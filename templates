<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>REALorFAKE – AI Video Detector</title>
  <style>
    /* --- 🎨 BASIC STYLES --- */
    :root { --bg: #000000; --card: #111111; --text: #ffffff; --accent: #ff0080; }
    body { 
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, sans-serif; 
      background: var(--bg); color: var(--text); 
      margin: 0; padding: 20px; 
      min-height: 100vh; display: flex; align-items: center; justify-content: center; 
    }
    
    .container { 
      width: 100%; max-width: 500px; 
      background: var(--card); padding: 40px 30px; 
      border-radius: 24px; box-shadow: 0 10px 40px rgba(255, 0, 128, 0.1); 
      border: 1px solid #222; text-align: center; 
    }
    
    h1 { 
      margin: 0 0 10px 0; font-size: 32px; letter-spacing: -1px; 
      background: linear-gradient(to right, #fff, #888); 
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; 
    }
    p.subtitle { color: #888; margin-bottom: 30px; font-size: 15px; }

    /* --- ⌨️ INPUTS & BUTTONS --- */
    input { 
      width: 100%; padding: 18px; margin-bottom: 15px; 
      background: #1a1a1a; border: 1px solid #333; border-radius: 12px; 
      color: white; font-size: 16px; outline: none; box-sizing: border-box; transition: 0.2s; 
    }
    input:focus { border-color: var(--accent); box-shadow: 0 0 0 2px rgba(255, 0, 128, 0.2); }
    
    button.action-btn { 
      width: 100%; padding: 18px; 
      background: white; color: black; border: none; border-radius: 12px; 
      font-size: 16px; font-weight: 800; cursor: pointer; transition: 0.2s; 
      text-transform: uppercase; letter-spacing: 1px; 
    }
    button.action-btn:hover { transform: scale(1.02); background: #f0f0f0; }
    button.action-btn:disabled { opacity: 0.5; cursor: wait; transform: none; }

    /* --- 📊 RESULTS --- */
    #result { margin-top: 30px; min-height: 20px; }
    .res-box { padding: 20px; border-radius: 16px; animation: popIn 0.3s; }
    .res-fake { background: rgba(255, 23, 68, 0.15); border: 2px solid #ff1744; color: #ff1744; }
    .res-real { background: rgba(0, 255, 0, 0.15); border: 2px solid #00ff00; color: #69f0ae; }
    .res-percent { font-size: 42px; font-weight: 900; display: block; margin: 10px 0; }
    
    /* --- 🔥 THE BIG PAY BUTTON --- */
    .pay-big {
        background: linear-gradient(135deg, #ff0080, #ff4081);
        color: white;
        padding: 24px 20px;
        border-radius: 20px;
        text-decoration: none;
        display: block;
        margin: 50px auto 10px;
        font-weight: bold;
        font-size: 20px;
        box-shadow: 0 10px 30px rgba(255, 0, 128, 0.3);
        transition: transform 0.2s;
        cursor: pointer;
        border: 1px solid rgba(255,255,255,0.1);
    }
    .pay-big:hover { transform: scale(1.02); box-shadow: 0 15px 40px rgba(255, 0, 128, 0.5); }
    .pay-sub { font-size: 13px; opacity: 0.8; font-weight: normal; margin-top: 5px; display: block; }

    /* --- 💰 MODAL (POPUP) --- */
    .modal-overlay { 
      position: fixed; top: 0; left: 0; width: 100%; height: 100%; 
      background: rgba(0,0,0,0.8); backdrop-filter: blur(5px); z-index: 999; 
      display: flex; justify-content: center; align-items: center; 
      opacity: 0; visibility: hidden; transition: 0.3s; 
    }
    .modal-overlay.active { opacity: 1; visibility: visible; }
    
    .modal-box { 
      background: #1a1a1a; padding: 30px; border-radius: 24px; 
      width: 90%; max-width: 400px; position: relative; border: 1px solid #333; 
      text-align: left; transform: translateY(20px); transition: 0.3s; 
    }
    .modal-overlay.active .modal-box { transform: translateY(0); }
    
    .close-btn { position: absolute; top: 15px; right: 20px; font-size: 28px; cursor: pointer; color: #666; }
    .close-btn:hover { color: #fff; }

    .crypto-box { 
      background: #000; padding: 15px; border: 1px dashed #444; border-radius: 10px; 
      margin-top: 15px; font-family: monospace; font-size: 13px; color: #aaa; 
      word-break: break-all; text-align: center; cursor: pointer; transition: 0.2s; 
    }
    .crypto-box:hover { border-color: #ff0080; color: #fff; background: #0a0a0a; }

    @keyframes popIn { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  </style>
</head>
<body>

<div class="container">
  <h1>REALorFAKE</h1>
  <p class="subtitle">AI Deepfake Detector for Instagram & TikTok</p>
  
  <input type="text" id="url" placeholder="Paste video link here...">
  <button onclick="check()" id="btn" class="action-btn">CHECK VIDEO</button>
  
  <div id="result"></div>
  
  <!-- 🔥 Premium Button -->
  <a class="pay-big" onclick="openModal()">
    🚀 GET PRO VERSION
    <span class="pay-sub">No Ads • Unlimited Scans • API Access</span>
  </a>
</div>

<!-- 💰 PAYMENT MODAL -->
<div id="paymentModal" class="modal-overlay">
  <div class="modal-box">
    <span class="close-btn" onclick="closeModal()">&times;</span>
    <h2 style="margin:0 0 10px 0; color:#fff">Lifetime PRO</h2>
    <p style="color:#888; font-size:14px; line-height:1.5">
      Get access to the advanced AI algorithm and remove all limits forever.
    </p>

    <div style="margin-top:25px">
      <div style="color:#fff; font-size:14px; font-weight:bold; margin-bottom:8px">USDT (TRC20) • $9.00</div>
      
      <!-- 👇 CLICK TO COPY BOX 👇 -->
      <div class="crypto-box" onclick="copyAddress()">
        TXzgMGjDHUt52QNTcXSP67qB4AmuB1H1KB
      </div>
      <div style="text-align:center; font-size:11px; color:#555; margin-top:8px">(Click to copy)</div>
    </div>

    <button class="action-btn" style="margin-top:25px; font-size:14px; padding:12px;" onclick="closeModal()">
      I Have Paid
    </button>
  </div>
</div>

<script>
// --- 🧠 LOGIC ---
async function check() {
  const input = document.getElementById('url');
  const btn = document.getElementById('btn');
  const resDiv = document.getElementById('result');
  
  // 1. Validation (Empty check)
  if (!input.value.trim()) {
    input.style.borderColor = '#ff1744';
    setTimeout(() => input.style.borderColor = '#333', 1000);
    return;
  }
  
  // 2. Loading State
  btn.disabled = true;
  btn.innerText = "ANALYZING...";
  resDiv.innerHTML = "";
  
  // 3. Simulated Result (Randomized)
  const isFake = Math.random() > 0.5;
  const confidence = Math.floor(88 + Math.random() * 11); // 88-99%
  
  setTimeout(() => {
    if (isFake) {
      resDiv.innerHTML = `
        <div class="res-box res-fake">
          <div style="font-size:12px; font-weight:bold; opacity:0.8">DETECTED</div>
          <span class="res-percent">${confidence}% AI</span>
          <div style="font-size:14px">Likely a Deepfake.</div>
        </div>
      `;
    } else {
      resDiv.innerHTML = `
        <div class="res-box res-real">
          <div style="font-size:12px; font-weight:bold; opacity:0.8">VERIFIED</div>
          <span class="res-percent">${confidence}% REAL</span>
          <div style="font-size:14px">This appears to be authentic.</div>
        </div>
      `;
    }
    
    btn.disabled = false;
    btn.innerText = "CHECK VIDEO";
  }, 2500); // 2.5 second delay
}

// --- 💰 PAYMENT MODAL & COPY ---
const modal = document.getElementById('paymentModal');

function openModal() {
  modal.classList.add('active');
}

function closeModal() {
  modal.classList.remove('active');
}

// Close on outside click
modal.addEventListener('click', (e) => {
  if (e.target === modal) closeModal();
});

function copyAddress() {
  const addr = "TXzgMGjDHUt52QNTcXSP67qB4AmuB1H1KB";
  navigator.clipboard.writeText(addr).then(() => {
    alert("Address copied! ✅");
  }).catch(() => {
    prompt("Copy manually:", addr);
  });
}
</script>

</body>
</html>
